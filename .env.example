# osu! OAuth app (osu.ppy.sh → Settings → OAuth). Client credentials grant, public scope.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Comma-separated ISO country codes. First one is the default.
COUNTRIES=US
ROSTER_SIZE=100
REQUESTS_PER_MINUTE=60
RANKINGS_REFRESH_MINUTES=30
HOT_WINDOW_MINUTES=120
COLD_EVERY=4

PORT=3000
DB_PATH=data/keyfeed.db
